{
  "name": "ft-ceptova",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,wrangler -c blue,green \"vite build --watch\" \"wrangler dev\"",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute ft-ceptova-db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute ft-ceptova-db --remote --file=./migrations/0001_init.sql",
    "db:seed:local": "wrangler d1 execute ft-ceptova-db --local --file=./migrations/0002_seed_foods.sql",
    "db:seed:remote": "wrangler d1 execute ft-ceptova-db --remote --file=./migrations/0002_seed_foods.sql",
    "db:seed2:local": "wrangler d1 execute ft-ceptova-db --local --file=./migrations/0003_seed_more_foods.sql",
    "db:seed2:remote": "wrangler d1 execute ft-ceptova-db --remote --file=./migrations/0003_seed_more_foods.sql"
  },
  "dependencies": {
    "hono": "^4.6.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "wrangler": "^3.114.17"
  }
}
